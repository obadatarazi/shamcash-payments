msgid "An unexpected error occurred during the test."
msgstr "حدث خطأ غير متوقع أثناء الاختبار."

#. translators: %s: hostname
#: includes/class-shamcash-connection-tester.php:195
#, php-format
msgid ""
"Could not resolve host “%s”. Check the Base URL spelling and your server DNS."
msgstr ""
"تعذر حل اسم المضيف “%s”. تحقق من تهجئة الرابط الأساسي وإعدادات DNS على "
"الخادم."

#. translators: %s: error details
#: includes/class-shamcash-connection-tester.php:202
#, php-format
msgid "Could not reach ShamCash server. Check Base URL or network. Details: %s"
msgstr ""
"تعذر الوصول إلى خادم شام كاش. تحقق من الرابط الأساسي أو الشبكة. التفاصيل: %s"

#: includes/class-shamcash-connection-tester.php:240
msgid "Connection failed: invalid Agent Key (1701)."
msgstr "فشل الاتصال: مفتاح الوكيل غير صالح (1701)."

#: includes/class-shamcash-connection-tester.php:241
msgid "Connection failed: agent is not active (1702)."
msgstr "فشل الاتصال: الوكيل غير نشط (1702)."

#: includes/class-shamcash-connection-tester.php:242
msgid "Connection failed: invalid encrypted data / Secret Key (1705)."
msgstr "فشل الاتصال: بيانات مشفّرة / مفتاح سري غير صالح (1705)."

#: includes/class-shamcash-connection-tester.php:243
msgid "Connection failed: account is blocked (1706)."
msgstr "فشل الاتصال: الحساب محظور (1706)."

