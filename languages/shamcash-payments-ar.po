#. Plugin Name of the plugin
#: shamcash-payments.php includes/class-shamcash-plugin.php:73
msgid "ShamCash Payments"
msgstr "مدفوعات شام كاش"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: shamcash-payments.php
msgid "https://sy.linkedin.com/in/obada-tarazi"
msgstr "https://sy.linkedin.com/in/obada-tarazi"

#. Description of the plugin
#: shamcash-payments.php
msgid ""
"Accept ShamCash payments in WooCommerce. Create bills, process refunds, "
"handle encrypted webhooks, and manage transactions with a clean admin "
"experience. English and Arabic translations included."
msgstr ""
"اقبل مدفوعات شام كاش في ووكومرس. أنشئ الفواتير، وعالج الاستردادات، وتعامل مع "
"إشعارات Webhook المشفّرة، وأدر المعاملات بتجربة إدارة نظيفة. يتضمن ترجمات "
"الإنجليزية والعربية."

#. Author of the plugin
#: shamcash-payments.php
msgid "Obada Altarazi"
msgstr "عبادة الترزي"

