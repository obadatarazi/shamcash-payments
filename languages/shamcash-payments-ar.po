msgstr "بيانات الاعتماد غير صالحة: %s"

#: includes/class-shamcash-connection-tester.php:140
msgid "Connection successful. Credentials verified with ShamCash servers."
msgstr "الاتصال ناجح. تم التحقق من بيانات الاعتماد بنجاح مع خوادم شام كاش."

#. translators: %s: API message
#: includes/class-shamcash-connection-tester.php:161
#, php-format
msgid ""
"Successfully reached the server (encryption & key verified). API message: %s"
